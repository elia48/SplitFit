<div class="trainings-index-page">
  <div class="trainings-index-container">

    <h1 class="trainings-index-title">My Sessions</h1>

    <% if @bookings.empty? %>
      <div class="bookings-empty">
        <i class="fa-regular fa-calendar-xmark"></i>
        <p>No sessions yet.<br>Explore trainings and book your first session!</p>
      </div>
    <% else %>
      <div class="trainings-index-list">
        <% @bookings.each do |booking| %>
          <div class="booking-card-wrap">
            <%= link_to booking_path(booking), class: "trainings-index-card-link" do %>
              <div class="trainings-index-card">
                <% if (card_img = training_image(booking.training)) %>
                  <img class="trainings-index-card-image" src="<%= card_img %>" alt="<%= booking.training.workout_type %>">
                <% else %>
                  <div class="trainings-index-card-image trainings-index-card-image--placeholder"></div>
                <% end %>

                <div class="trainings-index-card-content">
                  <h2><%= booking.training.workout_type %></h2>
                  <p class="trainings-index-coach">with <%= booking.training.user.name %></p>
                  <div class="trainings-index-meta">
                    <span>📍 <%= booking.training.place %></span>
                    <span>📅 <%= booking.training.date.strftime("%d %b · %H:%M") %></span>
                  </div>
                </div>

                <div class="trainings-index-side">
                  <span class="booking-status-pill booking-status-pill--<%= booking.status %>">
                    <%= booking.status.capitalize %>
                  </span>
                </div>

                <p class="trainings-index-price">€<%= format_price(booking.training.current_price_cents) %></p>
              </div>
            <% end %>

            <% if policy(booking).destroy? %>
              <div class="booking-cancel-row">
                <%= button_to "Cancel booking", booking_path(booking),
                      method: :delete,
                      data: { turbo_confirm: "Are you sure you want to cancel?" },
                      class: "booking-cancel-btn" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

  </div>
</div>
