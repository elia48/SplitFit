<h1>My Bookings</h1>

<% if @bookings.empty? %>
  <p>You have no bookings yet.</p>
<% else %>
  <% @bookings.each do |booking| %>
    <div>
      <h3><%= booking.training.workout_type %></h3>
      <p><%= booking.training.date %> · <%= booking.training.place %></p>
      <p>Status: <%= booking.status %></p>
      <p>Price: <%= booking.training.price_per_person %>€</p>
      <% if policy(booking).destroy? %>
        <%= button_to "Cancel", booking_path(booking), method: :delete, data: { turbo_confirm: "Cancel this booking?" } %>
      <% end %>
    </div>
  <% end %>
<% end %>
