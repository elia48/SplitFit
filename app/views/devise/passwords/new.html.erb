<% content_for :fullscreen, true %>

<div class="auth-page">
  <div class="auth-page__inner">

    <div class="auth-page__brand">
      <span class="auth-page__logo">SplitFit</span>
      <p class="auth-page__tagline">Train like a Pro, Pay like a Group.</p>
    </div>

    <div class="auth-card">
      <h1 class="auth-card__title">Forgot your password?</h1>
      <p class="auth-card__subtitle">We'll send you reset instructions</p>

      <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
        <%= f.error_notification %>

        <%= f.input :email,
            label: "Email",
            required: true,
            autofocus: true,
            input_html: { autocomplete: "email", class: "auth-input", placeholder: "you@example.com" },
            label_html: { class: "auth-label" },
            wrapper_html: { class: "auth-field" } %>

        <%= f.button :submit, "Send reset instructions", class: "auth-btn" %>
      <% end %>

      <div class="auth-links">
        <%= link_to "Back to log in", new_session_path(resource_name), class: "auth-link auth-link--muted" %>
      </div>
    </div>

  </div>
</div>
