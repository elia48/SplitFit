<% content_for :fullscreen, true %>

<div class="auth-page">
  <div class="auth-page__inner">

    <div class="auth-page__brand">
      <span class="auth-page__logo">SplitFit</span>
      <p class="auth-page__tagline">Train like a Pro, Pay like a Group.</p>
    </div>

    <div class="auth-card">
      <h1 class="auth-card__title">Welcome back</h1>
      <p class="auth-card__subtitle">Log in to your account</p>

      <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
        <%= f.error_notification %>

        <%= f.input :email,
            label: "Email",
            required: false,
            autofocus: true,
            input_html: { autocomplete: "email", class: "auth-input", placeholder: "you@example.com" },
            label_html: { class: "auth-label" },
            wrapper_html: { class: "auth-field" } %>

        <%= f.input :password,
            label: "Password",
            required: false,
            input_html: { autocomplete: "current-password", class: "auth-input", placeholder: "••••••••" },
            label_html: { class: "auth-label" },
            wrapper_html: { class: "auth-field" } %>

        <% if devise_mapping.rememberable? %>
          <%= f.input :remember_me, as: :boolean, label: "Remember me", wrapper_html: { class: "auth-checkbox-field" } %>
        <% end %>

        <%= f.button :submit, "Log in", class: "auth-btn" %>
      <% end %>

      <div class="auth-links">
        <%= link_to "Don't have an account? Sign up", new_registration_path(resource_name), class: "auth-link" %>
        <% if devise_mapping.recoverable? %>
          <%= link_to "Forgot your password?", new_password_path(resource_name), class: "auth-link auth-link--muted" %>
        <% end %>
      </div>
    </div>

    <h3 class="text-center">or</h3>

    <div class="auth-card">
      <%= link_to "See the trainings", trainings_path, class: "auth-btn text-center d-block"  %>
    </div>

  </div>
</div>
