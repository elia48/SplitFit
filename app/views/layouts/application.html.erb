<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "SplitFit" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="SplitFit">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Open Graph defaults — overridden per-page via content_for :og_* %>
    <meta property="og:site_name" content="SplitFit">
    <meta property="og:type"      content="website">
    <meta property="og:title"     content="<%= content_for?(:og_title) ? yield(:og_title) : "SplitFit — Train like a Pro, Pay like a Group" %>">
    <meta property="og:description" content="<%= content_for?(:og_description) ? yield(:og_description) : "Book group fitness sessions and split the cost. The more people join, the less everyone pays." %>">
    <meta property="og:url"       content="<%= content_for?(:og_url) ? yield(:og_url) : request.original_url %>">
    <% if content_for?(:og_image) %>
      <meta property="og:image"        content="<%= yield(:og_image) %>">
      <meta property="og:image:type"   content="image/jpeg">
      <% if content_for?(:og_image_width) %>
        <meta property="og:image:width"  content="<%= yield(:og_image_width) %>">
        <meta property="og:image:height" content="<%= yield(:og_image_height) %>">
      <% end %>
    <% end %>

    <%# Twitter / X card %>
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content="<%= content_for?(:og_title) ? yield(:og_title) : "SplitFit — Train like a Pro, Pay like a Group" %>">
    <meta name="twitter:description" content="<%= content_for?(:og_description) ? yield(:og_description) : "Book group fitness sessions and split the cost. The more people join, the less everyone pays." %>">
    <% if content_for?(:og_image) %>
      <meta name="twitter:image" content="<%= yield(:og_image) %>">
    <% end %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="manifest" href="<%= asset_path 'manifest.json' %>">
    <%= render 'shared/ios_pwa_links' %>
  </head>

  <body class="<%= 'body--fullscreen' if content_for?(:fullscreen) %>">
    <% unless content_for?(:fullscreen) %>
      <%= render "shared/header" %>
      <%= render "shared/bottom_nav" %>
    <% end %>
    <%= render "shared/flashes" %>
    <%= yield %>
  </body>
</html>
