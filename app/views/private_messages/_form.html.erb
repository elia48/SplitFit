<%= turbo_frame_tag "new_private_message_form" do %>
  <%= simple_form_for [private_chat, private_message],
        html: { class: "chat-form" } do |f| %>
    <div class="chat-form__row">
      <%= f.input :content,
            as: :string,
            label: false,
            placeholder: "Send a message...",
            input_html: {
              class: "chat-form__input",
              autocomplete: "off"
            },
            wrapper: false %>
      <button type="submit" class="chat-form__send">
        <i class="fa-solid fa-paper-plane"></i>
      </button>
    </div>
  <% end %>
<% end %>
