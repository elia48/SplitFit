<div class="chat-message"
     id="<%= dom_id(private_message) %>"
     data-message-user-id="<%= private_message.user_id %>">
  <div class="chat-message__avatar" data-avatar>
    <%= private_message.user.name.first.upcase %>
  </div>
  <div class="chat-message__bubble">
    <p class="chat-message__content"><%= private_message.content %></p>
    <span class="chat-message__time"><%= private_message.created_at.strftime("%H:%M") %></span>
  </div>
</div>
