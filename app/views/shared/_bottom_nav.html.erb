<div class="bottom-nav">

  <%= link_to trainings_path,
      class: "bottom-nav-item #{'active' if controller_name == 'trainings' && action_name == 'index'}" do %>

    <i class="fa-solid fa-magnifying-glass"></i>
    <span>Explore</span>

  <% end %>

  <%= link_to bookings_path,
      class: "bottom-nav-item #{'active' if controller_name == 'bookings'}" do %>

    <i class="fa-regular fa-calendar"></i>
    <span>Sessions</span>

  <% end %>

  <% if user_signed_in? && current_user.is_coach? %>
    <%= link_to new_training_path,
        class: "bottom-nav-item #{'active' if controller_name == 'trainings' && action_name == 'new'}" do %>

      <i class="fa-solid fa-plus"></i>
      <span>Create</span>

    <% end %>
  <% end %>

  <%= link_to messages_path,
      class: "bottom-nav-item #{'active' if controller_name == 'messages'}" do %>

    <div class="bottom-nav-icon-wrap">
      <i class="fa-regular fa-comment"></i>
      <% if user_signed_in? && current_user.chat_count > 0 %>
        <span class="chat-badge-dot"></span>
      <% end %>
    </div>
    <span>Chat</span>

  <% end %>

</div>
