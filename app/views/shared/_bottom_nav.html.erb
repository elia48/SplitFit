<div class="bottom-nav">

  <%= link_to trainings_path,
      class: "bottom-nav-item #{'active' if controller_name == 'trainings'}" do %>

    <i class="fa-solid fa-magnifying-glass"></i>
    <span>Explore</span>

  <% end %>

  <%= link_to bookings_path,
      class: "bottom-nav-item #{'active' if controller_name == 'bookings'}" do %>

