<div class="splitfit-header">

  <div class="splitfit-header-left">
    <i class="fa-solid fa-arrow-left"></i>

    <div class="splitfit-header-logo">
      SPLITFIT
    </div>
  </div>

  <% if user_signed_in? %>
    <div class="dropdown">
      <%= image_tag "retrato-hombre-blanco-aislado_53876-40306.avif",
          class: "splitfit-header-avatar",
          data: { bs_toggle: "dropdown" } %>

      <ul class="dropdown-menu dropdown-menu-end">
        <li><%= link_to "My profile", user_path(current_user), class: "dropdown-item" %></li>
        <li><hr class="dropdown-divider"></li>
        <li><%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item" %></li>
      </ul>
    </div>
  <% end %>

</div>
