<% editing ||= false %>
<%= simple_form_for training, html: { data: { controller: "training-form" } } do |f| %>
  <%= f.error_notification message: "Please fix the errors below:" %>

  <div class="training-new-card">
    <h2>Session Photo</h2>
    <div class="training-new-photo-field">
      <% if training.photo.attached? %>
        <%= image_tag training.photo, class: "training-new-photo-preview", alt: "Session photo" %>
      <% elsif training.user&.avatar&.attached? %>
        <%= image_tag training.user.avatar, class: "training-new-photo-preview training-new-photo-preview--fallback", alt: "Coach photo (fallback)" %>
        <p class="training-new-hint">No session photo — your profile photo will be shown.</p>
      <% else %>
        <div class="training-new-photo-placeholder">
          <i class="fa-solid fa-image"></i>
          <span>No photo yet</span>
        </div>
      <% end %>
      <%= f.input :photo,
          as: :file,
          label: "Session Photo",
          hint: "Upload a photo for this session. If none, your profile photo will be shown.",
          input_html: { class: "form-control", accept: "image/*" } %>
    </div>
  </div>

  <div class="training-new-card">
    <h2>Session Details</h2>

    <% unless editing %>
    <%= f.input :workout_type,
        as: :select,
        collection: ["HIIT", "Yoga", "CrossFit", "Boxing", "Pilates", "Strength", "Running", "Cycling"],
        include_blank: "Select type",
        label: "Workout Type",
        input_html: { data: { training_form_target: "field" } } %>
    <% end %>

    <div data-controller="address-autocomplete"
         data-address-autocomplete-api-key-value="<%= ENV["MAPBOX_API_KEY"] %>"
         data-action="submit->address-autocomplete#requirePlace">
      <label class="form-label">Location</label>
      <div data-address-autocomplete-target="map"></div>
      <div data-address-autocomplete-target="error" class="invalid-feedback" style="display:none;">Please select a location.</div>
      <%= f.hidden_field :place, data: { address_autocomplete_target: "address", training_form_target: "address" } %>
    </div>

    <%= f.input :date,
        as: :string,
        label: "Date & Time",
        input_html: {
          type: "datetime-local",
          min: 2.hours.from_now.strftime("%Y-%m-%dT%H:%M"),
          value: training.date&.strftime("%Y-%m-%dT%H:%M"),
          data: { training_form_target: "field" }
        } %>

    <%= f.input :duration,
        label: "Duration (minutes)",
        placeholder: "e.g. 60",
        input_html: { min: 1, data: { training_form_target: "field" } } %>

    <% unless editing %>
    <%= f.input :description,
        as: :text,
        label: "About this session",
        placeholder: "Describe what clients will do, the intensity level, what to bring...",
        input_html: { rows: 4, data: { training_form_target: "field" } } %>
    <% end %>
  </div>

  <% unless editing %>
  <div class="training-new-card">
    <h2>Pricing & Capacity</h2>

    <div class="training-new-price-group">
      <label class="training-new-label">Price per session (€)</label>
      <div class="training-new-price-wrap">
        <span class="training-new-currency">€</span>
        <input
          type="number"
          name="training[price]"
          step="0.01"
          min="0.01"
          placeholder="85.00"
          value="<%= training.coach_price_cents.to_i > 0 ? sprintf('%.2f', training.coach_price_cents / 100.0) : '' %>"
          class="form-control training-new-price-input"
          data-training-form-target="field"
        >
      </div>
      <small class="training-new-hint">Clients split this equally — more participants means lower price per person.</small>
    </div>

    <div data-controller="capacity" data-action="submit->capacity#validate">
      <%= f.input :min_people,
          label: "Minimum participants",
          placeholder: "e.g. 2",
          input_html: {
            min: 2,
            data: {
              capacity_target: "min",
              training_form_target: "field",
              action: "input->capacity#syncMax"
            }
          } %>

      <%= f.input :max_people,
          label: "Maximum participants",
          placeholder: "e.g. 10",
          input_html: {
            min: 2,
            data: {
              capacity_target: "max",
              training_form_target: "field"
            }
          } %>
    </div>
  </div>
  <% end %>

  <%= f.hidden_field :status, value: training.status.presence || "draft" %>

  <div class="training-new-actions">
    <%= f.button :submit, submit_label, class: "training-new-submit", disabled: true, data: { training_form_target: "submit" } %>
    <%= link_to "Cancel", cancel_path, class: "training-new-cancel" %>
  </div>
<% end %>
