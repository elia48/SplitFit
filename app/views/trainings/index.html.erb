<div class="trainings-index-page">
  <div class="trainings-index-container">

    <h1 class="trainings-index-title">Trainings</h1>

<%= form_with url: trainings_path, method: :get, class: "trainings-search-form" do %>
  <div class="trainings-index-search">

    <i class="fa-solid fa-magnifying-glass trainings-search-icon"></i>

    <%= text_field_tag :query,
        params[:query],
        placeholder: "Search for sessions, workouts or places",
        class: "trainings-index-search-input" %>

    <details class="trainings-filter-dropdown">
      <summary class="trainings-filter-button">
        <i class="fa-solid fa-sliders"></i>
      </summary>

      <div class="trainings-filter-panel">
        <label>Location</label>
        <%= text_field_tag :location, params[:location], placeholder: "Current location", class: "trainings-filter-input" %>

        <label>Workout type</label>
        <%= select_tag :workout_type,
            options_for_select(["", "Strength", "HIIT", "Yoga", "Pilates", "Crossfit"], params[:workout_type]),
            class: "trainings-filter-select" %>

        <label>Price range (your split)</label>
        <div class="trainings-filter-price-row">
          <%= number_field_tag :min_price, params[:min_price], placeholder: "Min", class: "trainings-filter-input" %>
          <%= number_field_tag :max_price, params[:max_price], placeholder: "Max", class: "trainings-filter-input" %>
        </div>

        <%= submit_tag "Show results", class: "trainings-filter-submit" %>
      </div>
    </details>

  </div>
<% end %>

    <div class="trainings-index-tags">
      <span class="trainings-index-pill active">All</span>
      <span class="trainings-index-pill">Weight Lifting</span>
      <span class="trainings-index-pill">Yoga</span>
      <span class="trainings-index-pill">HIIT</span>
      <span class="trainings-index-pill">More⌄</span>
    </div>

    <div class="trainings-index-list">
      <% @trainings.each do |training| %>
        <%= link_to training_path(training), class: "trainings-index-card-link" do %>
          <div class="trainings-index-card">

            <img
              class="trainings-index-card-image"
              src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=600"
              alt="Training image"
            >

            <div class="trainings-index-card-content">
              <span class="trainings-index-badge"><%= training.workout_type %></span>

              <h2><%= training.workout_type %></h2>

              <p class="trainings-index-coach">
                with <%= training.user.name %>
              </p>

              <div class="trainings-index-meta">
                <span>⭐ 4.8/5</span>
                <span>📍 <%=training.place %></span>
              </div>

              <p class="trainings-index-price">
                €<%= training.price_per_person %>
              </p>
              <p class="trainings-index-fullprice"><s>€<%= training.coach_price %></s></p>
            </div>

            <div class="trainings-index-side">
              <i class="fa-regular fa-heart trainings-index-heart"></i>

              <p class="trainings-index-spots">
                <%= training.min_people %>-<%= training.max_people %> people
              </p>
            </div>

          </div>
        <% end %>
      <% end %>
    </div>

  </div>
</div>
