<div class="trainings-index-page">
  <div class="trainings-index-container">

    <h1 class="trainings-index-title">Trainings</h1>

<%= form_with url: trainings_path, method: :get, class: "trainings-search-form" do %>
  <div class="trainings-index-search">

    <i class="fa-solid fa-magnifying-glass trainings-search-icon"></i>

    <%= text_field_tag :query,
        params[:query],
        placeholder: "Search for sessions, workouts or places",
        class: "trainings-index-search-input" %>

    <details class="trainings-filter-dropdown">
      <summary class="trainings-filter-button">
        <i class="fa-solid fa-sliders"></i>
      </summary>

      <div class="trainings-filter-panel">
        <label>Location</label>
        <%= text_field_tag :location, params[:location], placeholder: "Current location", class: "trainings-filter-input" %>

        <label>Workout type</label>
        <%= select_tag :workout_type,
            options_for_select(["", "Strength", "HIIT", "Yoga", "Pilates", "Crossfit"], params[:workout_type]),
            class: "trainings-filter-select" %>

        <label>Price range (your split)</label>
        <div class="trainings-filter-price-row">
          <%= number_field_tag :min_price, params[:min_price], placeholder: "Min", class: "trainings-filter-input" %>
          <%= number_field_tag :max_price, params[:max_price], placeholder: "Max", class: "trainings-filter-input" %>
        </div>

        <%= submit_tag "Show results", class: "trainings-filter-submit" %>
      </div>
    </details>

  </div>
<% end %>

    <div class="trainings-index-tags">
      <% workout_pills = [
           ["All",            nil],
           ["Weight Lifting", "Strength"],
           ["Yoga",           "Yoga"],
           ["HIIT",           "HIIT"],
           ["CrossFit",       "CrossFit"],
           ["Pilates",        "Pilates"],
           ["Boxing",         "Boxing"]
         ] %>
      <% workout_pills.each do |label, type| %>
        <%= link_to trainings_path(workout_type: type, query: params[:query], location: params[:location]),
              class: "trainings-index-pill #{ params[:workout_type] == type || (type.nil? && params[:workout_type].blank?) ? 'active' : '' }" do %>
          <%= label %>
        <% end %>
      <% end %>
    </div>

    <div class="trainings-index-list">
      <% @trainings.each do |training| %>
        <% coach = training.user %>
        <% paid_count = training.bookings.count { |b| b.status == "paid" } %>
        <% already_joined = @my_booked_training_ids.include?(training.id) %>
        <div class="trainings-index-card">

          <% if (card_img = training_image(training)) %>
            <img class="trainings-index-card-image" src="<%= card_img %>" alt="Training image">
          <% else %>
            <div class="trainings-index-card-image trainings-index-card-image--placeholder"></div>
          <% end %>

          <div class="trainings-index-card-content">
            <div class="trainings-index-card-top-row">
              <span class="trainings-index-status-badge trainings-index-status-<%= training.status %>"><%= training.status.capitalize %></span>
            </div>

            <h2><%= training.workout_type %></h2>

            <p class="trainings-index-coach">
              with <%= link_to coach.name, user_path(coach), class: "trainings-index-coach-link" %>
            </p>

            <div class="trainings-index-meta">
              <% avg = coach.average_rating %>
              <span>⭐ <%= avg ? "#{avg}/5" : "No reviews" %></span>
              <span>📍 <%= training.place %></span>
            </div>

            <div class="trainings-index-datetime">
              <i class="fa-regular fa-calendar-days"></i>
              <%= training.date.strftime("%a %d %b") %> · <%= training.duration %> min
            </div>

            <div class="trainings-index-participants">
              <span><%= paid_count %> / <%= training.max_people %> joined</span>
              <% if already_joined %>
                <span class="trainings-index-joined-badge">You're in!</span>
              <% end %>
            </div>
          </div>

          <div class="trainings-index-side">
            <div class="trainings-index-price-block">
              <span class="trainings-index-price">€<%= sprintf("%.2f", training.current_price_cents / 100.0) %></span>
              <span class="trainings-index-price-label">/person</span>
              <% if training.min_price_cents < training.current_price_cents %>
                <span class="trainings-index-min-price">
                  Could reach €<%= sprintf("%.2f", training.min_price_cents / 100.0) %>
                </span>
              <% end %>
            </div>
          </div>

          <div class="trainings-index-card-footer">
            <div class="trainings-index-share-wrap"
                 data-controller="share"
                 data-action="click@window->share#closeDropdown"
                 data-share-url-value="<%= training_url(training) %>"
                 data-share-title-value="<%= training.workout_type %> on SplitFit"
                 data-share-text-value="Join me for <%= training.workout_type %> with <%= coach.name %>! From €<%= sprintf('%.2f', training.min_price_cents / 100.0) %>/person.">
              <button type="button"
                      class="trainings-index-share-btn"
                      data-action="click->share#share">
                <i class="fa-solid fa-share-nodes"></i> Share the training
              </button>
              <div class="share-dropdown" data-share-target="dropdown">
                <button type="button" class="share-dropdown__item" data-action="click->share#whatsapp">
                  <i class="fa-brands fa-whatsapp"></i> WhatsApp
                </button>
                <button type="button" class="share-dropdown__item" data-action="click->share#twitter">
                  <i class="fa-brands fa-x-twitter"></i> Twitter / X
                </button>
                <button type="button" class="share-dropdown__item" data-action="click->share#facebook">
                  <i class="fa-brands fa-facebook"></i> Facebook
                </button>
                <div class="share-dropdown__divider"></div>
                <button type="button" class="share-dropdown__item share-dropdown__item--more" data-action="click->share#native">
                  <i class="fa-solid fa-ellipsis"></i> More options
                </button>
              </div>
            </div>
            <%= link_to training_path(training), class: "trainings-index-view-btn" do %>
              View session
            <% end %>
          </div>

        </div>
      <% end %>
    </div>

  </div>
</div>
