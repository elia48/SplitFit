<% content_for :og_title, "#{@training.workout_type} with #{@coach.name} — SplitFit" %>
<% content_for :og_description, "Join #{@training.workout_type} in #{@training.place.split(',').first.strip} on #{@training.date.strftime('%d %b %Y')}. From €#{format_price(@training.min_price_cents)}/person — the more people join, the less you pay." %>
<% content_for :og_url, training_url(@training) %>
<% if (img = training_og_image_url(@training)) %>
  <% content_for :og_image, img %>
  <% content_for :og_image_width, "1200" %>
  <% content_for :og_image_height, "630" %>
<% end %>

<div class="training-show-page">
<div class="training-show">

  <%# ── Hero ──────────────────────────────────────────────────────── %>
  <div class="training-show__hero">
    <% if (hero_src = training_image(@training)) %>
      <img class="training-show__hero-img" src="<%= hero_src %>" alt="<%= @training.workout_type %>">
    <% end %>
    <div class="training-show__hero-overlay"></div>

    <div class="training-show__coach-actions">
      <% if user_signed_in? %>
        <% if policy(@training).update? %>
          <%= link_to "Edit", edit_training_path(@training), class: "training-show__coach-btn training-show__coach-btn--edit" %>
        <% end %>
        <% if policy(@training).publish? %>
          <%= button_to "Publish", publish_training_path(@training), method: :patch,
              class: "training-show__coach-btn training-show__coach-btn--publish" %>
        <% end %>
        <% if policy(@training).cancel? %>
          <%= button_to "Cancel", cancel_training_path(@training), method: :patch,
              data: { turbo_confirm: "Cancel this session?" },
              class: "training-show__coach-btn training-show__coach-btn--cancel" %>
        <% end %>
        <% if policy(@training).close? %>
          <%= button_to "Close & refund", close_training_path(@training), method: :patch,
              data: { turbo_confirm: "Close this session and process refunds?" },
              class: "training-show__coach-btn training-show__coach-btn--close" %>
        <% end %>
      <% end %>
    </div>

    <div class="training-show__hero-content">
      <span class="training-show__status-badge"><%= @training.status.upcase %></span>
      <h1 class="training-show__type"><%= @training.workout_type %></h1>
      <p class="training-show__coach">
        <% if @coach.avatar.present? %>
          <%= image_tag @coach.avatar, alt: @coach.name %>
        <% end %>
        with <%= @coach.name %>
      </p>
    </div>
  </div>

  <div class="training-show__body">

    <%# ── Stats grid ─────────────────────────────────────────────── %>
    <div class="training-show__stats">
      <div class="training-show__stat">
        <div class="training-show__stat-icon"><i class="fa-regular fa-calendar"></i></div>
        <div class="training-show__stat-content">
          <span class="training-show__stat-label">Date</span>
          <span class="training-show__stat-value"><%= @training.date.strftime("%-d %b %Y") %></span>
        </div>
      </div>

      <div class="training-show__stat">
        <div class="training-show__stat-icon"><i class="fa-solid fa-clock"></i></div>
        <div class="training-show__stat-content">
          <span class="training-show__stat-label">Time</span>
          <span class="training-show__stat-value"><%= @training.date.strftime("%H:%M") %></span>
        </div>
      </div>

      <div class="training-show__stat">
        <div class="training-show__stat-icon"><i class="fa-solid fa-hourglass-half"></i></div>
        <div class="training-show__stat-content">
          <span class="training-show__stat-label">Duration</span>
          <span class="training-show__stat-value"><%= @training.duration %> min</span>
        </div>
      </div>

      <div class="training-show__stat training-show__stat--full">
        <div class="training-show__stat-icon"><i class="fa-solid fa-location-dot"></i></div>
        <div class="training-show__stat-content">
          <span class="training-show__stat-label">Location</span>
          <span class="training-show__stat-value"><%= @training.place.split(",").first(2).join(",").strip %></span>
        </div>
      </div>
    </div>

    <%# ── About ──────────────────────────────────────────────────── %>
    <div class="training-show__card">
      <p class="training-show__card-title">About this session</p>
      <p class="training-show__about-text">
        <%= @training.description.presence || "No description provided yet." %>
      </p>
    </div>

    <%# ── Map ──────────────────────────────────────────────────── %>
    <div style="width: 100%; height: 300px;"
        data-controller="map"
        data-map-markers-value="<%= @markers.to_json %>"
        data-map-api-key-value="<%= ENV['MAPBOX_API_KEY'] %>">
    </div>

    <%# ── Pricing & booking ──────────────────────────────────────── %>
    <div class="training-show__card">
      <p class="training-show__card-title">Pricing</p>

      <div class="training-show__pricing-row">
        <div>
          <div class="training-show__price-current">
            €<%= format_price(@training.current_price_cents) %>
            <span class="training-show__price-unit">/person</span>
          </div>
          <div class="training-show__price-original">
            €<%= format_price(@training.coach_price_cents) %> full price
          </div>
        </div>
      </div>

      <div class="training-show__participants-bar">
        <div class="training-show__participants-label">
          <span>Spots filled</span>
          <strong><%= @training.bookings.paid.count %> / <%= @training.max_people %></strong>
        </div>
        <div class="training-show__bar-bg">
          <div class="training-show__bar-fill"
               style="width: <%= [(@training.bookings.paid.count.to_f / @training.max_people * 100).round, 100].min %>%">
          </div>
        </div>
      </div>

      <div class="training-show__pricing-note">
        <i class="fa-solid fa-circle-info"></i>
        <p>The more people join, the lower the price per person. Final price locks 2 hours before the session or where the maximum number of people is reached.</p>
      </div>

      <% if user_signed_in? %>
        <% if @pending_booking %>
          <div class="training-show__pending-notice">
            <i class="fa-solid fa-clock"></i>
            <p>You have a pending booking — your spot is not confirmed until payment is completed.</p>
          </div>
          <div class="training-show__pending-actions">
            <%= link_to "Complete payment", new_booking_payment_path(@pending_booking),
                class: "training-show__book-btn" %>
            <%= button_to "Cancel booking", booking_path(@pending_booking),
                method: :delete,
                data: { turbo_confirm: "Cancel this pending booking?" },
                class: "training-show__cancel-pending-btn" %>
          </div>
        <% elsif policy(Booking.new(training: @training)).create? %>
          <%= button_to "Book this session", training_bookings_path(@training),
              method: :post, class: "training-show__book-btn" %>
        <% end %>
      <% else %>
        <%= link_to "Log in to book this session", new_user_session_path, class: "training-show__book-btn" %>
      <% end %>
    </div>

    <%# ── Coach ──────────────────────────────────────────────────── %>
    <div class="training-show__card">
      <p class="training-show__card-title">Coach</p>
      <div class="training-show__coach-card">
        <% if @coach.avatar.attached? %>
          <img class="training-show__coach-avatar" src="<%= url_for(@coach.avatar) %>" alt="<%= @coach.name %>">
        <% else %>
          <div class="training-show__coach-avatar training-show__coach-avatar--placeholder"><%= @coach.name[0].upcase %></div>
        <% end %>
        <div class="training-show__coach-info">
          <h3><%= @coach.name %></h3>
          <p><%= @coach.speciality.presence || "Personal Trainer" %></p>
        </div>
        <%= link_to "View profile", user_path(@coach), class: "training-show__coach-link" %>
      </div>
    </div>

    <%# ── Reviews ────────────────────────────────────────────────── %>
    <div class="training-show__card">
      <p class="training-show__card-title">
        Reviews (<%= @coach.received_reviews.count %>)
      </p>

      <% if @coach.received_reviews.any? %>
        <% @coach.received_reviews.order(created_at: :desc).limit(5).each do |review| %>
          <div class="training-show__review-card">
            <div class="training-show__review-header">
              <span class="training-show__review-author"><%= review.user&.name&.split&.first || "Member" %></span>
              <div class="training-show__review-stars">
                <% review.score.times do %><i class="fa-solid fa-star"></i><% end %>
                <% (5 - review.score).times do %><i class="fa-regular fa-star"></i><% end %>
              </div>
            </div>
            <p class="training-show__review-text"><%= review.description %></p>
          </div>
        <% end %>
      <% else %>
        <p class="training-show__no-reviews">No reviews yet.</p>
      <% end %>

      <% if user_signed_in? && policy(@review).create? %>
        <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid #f0e0d8;">
          <p class="training-show__card-title">Leave a review</p>
          <%= simple_form_for [@training, @review], html: { class: "training-show__review-form" } do |f| %>
            <%= f.input :score,
                collection: 1..5,
                prompt: "Rating",
                label: false,
                input_html: { class: "form-select form-select-sm" } %>
            <%= f.input :description,
                as: :text,
                label: false,
                placeholder: "How was the session?",
                input_html: { class: "form-control form-control-sm", rows: 3 } %>
            <%= f.submit "Submit review", class: "training-show__book-btn" %>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
</div>
</div>
