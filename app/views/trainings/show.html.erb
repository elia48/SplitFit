
<div style="border: 1px solid #000; padding: 30px">
    <h1><%= @training.workout_type %></h1>
    <h2>with <%= @coach.name %></h2>

    <% if policy(@training).update? %>
      <%= link_to "Edit", edit_training_path(@training), class: "btn btn-outline-secondary btn-sm me-2" %>
    <% end %>
    <% if policy(@training).publish? %>
      <%= button_to "Publish Session", publish_training_path(@training), method: :patch,
          class: "btn btn-success btn-sm me-2" %>
    <% end %>
    <% if policy(@training).cancel? %>
      <%= button_to "Cancel Session", cancel_training_path(@training), method: :patch,
          data: { turbo_confirm: "Are you sure you want to cancel this session?" },
          class: "btn btn-outline-danger btn-sm" %>
    <% end %>
    <% if policy(@training).reopen? %>
      <%= button_to "Reopen Session", reopen_training_path(@training), method: :patch,
          class: "btn btn-outline-success btn-sm" %>
    <% end %>
</div>
<div class="d-flex">
    <div>
        <h3>date</h3>
        <%= @training.date %>
    </div>
    <div>
        <h3>duration</h3>
        <%= @training.duration %> min
    </div>
</div>
<div style="border: 1px solid #000; padding: 30px">
    <h2><%= @training.place %></h2>
</div>
<div class="d-flex">
    <div><h3>joined participants</h3></div>
    <div><h3><%= @training.bookings.size %> / <%= @training.max_people %></h3></div>
</div>
<div>
    <div style="border: 1px solid #000; padding: 30px">
        <div class="d-flex">
            <div>
                <h2>Dynamic Pricing</h2>
                <p>The more people join, the less you pay.</p>
            </div>
            <div>
                <%= @training.status %>
            </div>
        </div>
        <div class="d-flex">
            <div>
                <div><s><%= sprintf("%.2f", @training.coach_price_cents / 100.0) %>€</s></div>
                <div><h2><%= sprintf("%.2f", @training.current_price_cents / 100.0) %>€</h2></div>
            </div>
        </div>
            <% if policy(Booking.new(training: @training)).create? %>
            <%= button_to "Book this training", training_bookings_path(@training), method: :post, class: "btn btn-primary" %>
            <% end %>
        <div  style="border: 1px solid #000; padding: 30px" class="d-flex">
            <div>
                <i class="fa-solid fa-circle-info"></i>
            </div>
            <div>
                <p>Final price will be locked 2 hours before the session.</p>
            </div>
        </div>
    </div>
</div>

<div>
    <h2>About the session</h2>
    <p>This high-intensity calisthenics session focuses on core stability and explosive power. Alex Rivers will guide you through advanced movements like muscle-ups, L-sits, and dynamic plank variations. Suitable for intermediate to advanced fitness enthusiasts.</p>
</div>

<% if policy(@review).create? %>
  <h2>Let us know if the coach did a good job</h2>

  <%= simple_form_for [@training, @review] do |f| %>
    <%= f.input :score,
                collection: 1..5,
                prompt: "Select a rating" %>

    <%= f.input :description %>

    <%= f.submit "Submit review",
                 class: "btn btn-primary" %>
  <% end %>
<% end %>

<h3>Coach reviews</h3>

<% @coach.received_reviews.each do |review| %>
  <div class="review-card">
    <p><strong>Rating:</strong> <%= review.score %>/5</p>
    <p><%= review.description %></p>
    <small>
      By <%= review.user&.name || "Deleted user" %>
    </small>
  </div>
<% end %>