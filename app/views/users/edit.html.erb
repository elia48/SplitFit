<div class="coach-show-page">
  <div class="coach-show-container">

    <section class="coach-show-card">
      <h2>Edit Profile</h2>

      <%= simple_form_for @user, url: user_path(@user), method: :patch, html: { multipart: true } do |f| %>

        <div class="user-edit-field">
          <%= f.label :name, "Name" %>
          <%= f.input :name, label: false, input_html: { class: "user-edit-input" }, wrapper: false %>
        </div>

        <% if @user.is_coach? %>
          <div class="user-edit-field">
            <%= f.label :speciality, "Speciality" %>
            <%= f.input :speciality, label: false, placeholder: "e.g. Strength & Conditioning",
                  input_html: { class: "user-edit-input" }, wrapper: false %>
          </div>

          <div class="user-edit-field">
            <%= f.label :description, "About you" %>
            <%= f.input :description, as: :text, label: false, placeholder: "Tell clients about your style and experience",
                  input_html: { class: "user-edit-input user-edit-textarea", rows: 4 }, wrapper: false %>
          </div>
        <% end %>

        <div class="user-edit-field">
          <%= f.label :address, "Address" %>
          <%= f.input :address, label: false, placeholder: "Your city or neighborhood",
                input_html: { class: "user-edit-input" }, wrapper: false %>
        </div>

        <div class="user-edit-field">
          <%= f.label :payment_method, "Payment method" %>
          <%= f.input :payment_method, label: false, placeholder: "e.g. Bizum, Revolut, PayPal",
                input_html: { class: "user-edit-input" }, wrapper: false %>
        </div>

        <div class="user-edit-field">
          <%= f.label :avatar, "Profile photo" %>

          <div class="user-edit-avatar-preview" id="avatar-preview-wrapper">
            <% if @user.avatar.attached? %>
              <%= image_tag @user.avatar, class: "user-edit-avatar-img", id: "avatar-preview-img" %>
            <% else %>
              <div class="user-edit-avatar-placeholder" id="avatar-preview-img">
                <i class="fa-solid fa-user"></i>
              </div>
            <% end %>
          </div>
          <%= f.input :avatar, as: :file, label: false,
                input_html: {
                  class: "user-edit-file-input",
                  accept: "image/*",
                  id: "avatar-file-input"
                }, wrapper: false %>
        </div>

        <div class="user-edit-actions">
          <%= f.button :submit, "Save changes", class: "coach-show-main-btn" %>
          <%= link_to "Cancel", user_path(@user), class: "user-edit-cancel" %>
        </div>

      <% end %>
    </section>

  </div>
</div>

<script>
  document.getElementById("avatar-file-input").addEventListener("change", function(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(ev) {
      const wrapper = document.getElementById("avatar-preview-wrapper");
      wrapper.innerHTML = '<img src="' + ev.target.result + '" class="user-edit-avatar-img" id="avatar-preview-img">';
    };
    reader.readAsDataURL(file);
  });
</script>
