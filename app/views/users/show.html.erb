<div class="coach-show-page">
  <div class="coach-show-container">

    <section class="coach-show-hero">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar, class: "coach-show-hero-image", alt: "Profile" %>
      <% else %>
        <div class="coach-show-hero-image coach-show-hero-image--placeholder">
          <i class="fa-solid fa-user"></i>
        </div>
      <% end %>

      <div class="coach-show-hero-overlay"></div>

      <% if @own_profile %>
        <%= link_to "Edit", edit_user_path(@user), class: "coach-show-edit-btn" %>
      <% end %>

      <div class="coach-show-hero-content">
        <% if @user.is_coach? %>
          <div class="coach-show-score">
            <i class="fa-solid fa-star"></i>
            <span>
              <% if @user.average_rating.present? %>
                <p>⭐ <%= @user.average_rating %>/5</p>
              <% else %>
                <p>No reviews yet</p>
              <% end %>
            </span>
          </div>
        <% end %>

        <h1><%= @user.name.presence || @user.email %></h1>

        <% if @user.is_coach? %>
          <p class="coach-show-speciality">
            <%= @user.speciality.presence || "Personal Trainer" %>
          </p>
        <% end %>
      </div>
    </section>

    <section class="coach-show-card">
      <h2>About</h2>
      <p><%= @user.description.presence || "No description yet." %></p>
    </section>

    <% if @user.is_coach? %>

      <% if @own_profile && @draft_trainings.any? %>
        <section class="coach-show-card">
          <div class="coach-show-section-title">
            <h2>Drafts</h2>
            <span class="badge bg-warning text-dark"><%= @draft_trainings.count %></span>
          </div>
          <div class="coach-show-trainings">
            <% @draft_trainings.each do |training| %>
              <%= link_to training_path(training), class: "coach-show-training-card" do %>
                <% if (img = training_image(training)) %>
                  <img src="<%= img %>" alt="Training">
                <% else %>
                  <div class="coach-show-training-card__placeholder"></div>
                <% end %>
                <div class="coach-show-training-content">
                  <h3><%= training.workout_type %></h3>
                  <p><%= training.place %></p>
                  <span><%= training.date&.strftime("%d %b %Y") || "No date set" %></span>
                </div>
                <span class="coach-show-training-badge coach-show-training-badge--draft">Draft</span>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>

      <section class="coach-show-card">
        <div class="coach-show-section-title">
          <h2>Active Trainings</h2>
          <% if @own_profile %>
            <%= link_to "New", new_training_path, class: "coach-show-small-link" %>
          <% end %>
        </div>

        <div class="coach-show-trainings">
          <% @trainings.each do |training| %>
            <%= link_to training_path(training), class: "coach-show-training-card" do %>
              <% if (img = training_image(training)) %>
                <img src="<%= img %>" alt="Training">
              <% else %>
                <div class="coach-show-training-card__placeholder"></div>
              <% end %>
              <div class="coach-show-training-content">
                <h3><%= training.workout_type %></h3>
                <p><%= training.place %></p>
                <span>€<%= format_price(training.coach_price_cents) %>/pp</span>
              </div>
              <i class="fa-regular fa-heart" style="margin-right:12px; color:#e8b4a0;"></i>
            <% end %>
          <% end %>

          <% if @trainings.empty? %>
            <p class="coach-show-empty">No active trainings yet.</p>
          <% end %>
        </div>
      </section>

      <section class="coach-show-card">
        <h2>Training History</h2>
        <div class="coach-show-trainings">
          <% @past_trainings.each do |training| %>
            <%= link_to training_path(training), class: "coach-show-training-card" do %>
              <% if (img = training_image(training)) %>
                <img src="<%= img %>" alt="Training">
              <% else %>
                <div class="coach-show-training-card__placeholder"></div>
              <% end %>
              <div class="coach-show-training-content">
                <h3><%= training.workout_type %></h3>
                <p><%= training.place %></p>
                <span><%= training.date.strftime("%d %b %Y") %></span>
              </div>
              <span class="coach-show-training-badge coach-show-training-badge--past">Past</span>
            <% end %>
          <% end %>
          <% if @past_trainings.empty? %>
            <p class="coach-show-empty">No past trainings yet.</p>
          <% end %>
        </div>
      </section>

    <% else %>

      <section class="coach-show-card">
        <h2>Confirmed Trainings</h2>
        <div class="coach-show-trainings">
          <% @confirmed_bookings.each do |booking| %>
            <%= link_to training_path(booking.training), class: "coach-show-training-card" do %>
              <% if (img = training_image(booking.training)) %>
                <img src="<%= img %>" alt="Training">
              <% else %>
                <div class="coach-show-training-card__placeholder"></div>
              <% end %>
              <div class="coach-show-training-content">
                <h3><%= booking.training.workout_type %></h3>
                <p><%= booking.training.place %></p>
                <span><%= booking.training.date.strftime("%d %b %Y") %></span>
              </div>
              <span class="coach-show-training-badge coach-show-training-badge--confirmed">Confirmed</span>
            <% end %>
          <% end %>
          <% if @confirmed_bookings.empty? %>
            <p class="coach-show-empty">No confirmed trainings.</p>
          <% end %>
        </div>
      </section>

      <section class="coach-show-card">
        <h2>Pending Trainings</h2>
        <div class="coach-show-trainings">
          <% @pending_bookings.each do |booking| %>
            <%= link_to training_path(booking.training), class: "coach-show-training-card" do %>
              <% if (img = training_image(booking.training)) %>
                <img src="<%= img %>" alt="Training">
              <% else %>
                <div class="coach-show-training-card__placeholder"></div>
              <% end %>
              <div class="coach-show-training-content">
                <h3><%= booking.training.workout_type %></h3>
                <p><%= booking.training.place %></p>
                <span><%= booking.training.date.strftime("%d %b %Y") %></span>
              </div>
              <span class="coach-show-training-badge coach-show-training-badge--pending">Pending</span>
            <% end %>
          <% end %>
          <% if @pending_bookings.empty? %>
            <p class="coach-show-empty">No pending trainings.</p>
          <% end %>
        </div>
      </section>

      <section class="coach-show-card">
        <h2>Training History</h2>
        <div class="coach-show-trainings">
          <% @past_bookings.each do |booking| %>
            <%= link_to training_path(booking.training), class: "coach-show-training-card" do %>
              <% if (img = training_image(booking.training)) %>
                <img src="<%= img %>" alt="Training">
              <% else %>
                <div class="coach-show-training-card__placeholder"></div>
              <% end %>
              <div class="coach-show-training-content">
                <h3><%= booking.training.workout_type %></h3>
                <p><%= booking.training.place %></p>
                <span><%= booking.training.date.strftime("%d %b %Y") %></span>
              </div>
              <span class="coach-show-training-badge coach-show-training-badge--past">Past</span>
            <% end %>
          <% end %>
          <% if @past_bookings.empty? %>
            <p class="coach-show-empty">No past trainings yet.</p>
          <% end %>
        </div>
      </section>

    <% end %>

    <% if @own_profile %>
      <section class="coach-show-card coach-show-private-card">
        <h2>Personal Data</h2>

        <div class="coach-show-data-row">
          <span>Email</span>
          <strong><%= @user.email %></strong>
        </div>

        <div class="coach-show-data-row">
          <span>Password</span>
          <%= link_to "Change", edit_user_registration_path %>
        </div>

        <div class="coach-show-data-row">
          <span>Address</span>
          <strong><%= @user.address.presence || "Not added" %></strong>
        </div>

        <div class="coach-show-data-row">
          <span>Payment method</span>
          <strong><%= @user.payment_method.presence || "Not added" %></strong>
        </div>

        <% if @user.is_coach? %>
          <div class="coach-show-data-row">
            <span>Stripe payouts</span>
            <% if @user.stripe_account_id.present? %>
              <strong class="text-success"><i class="fa-solid fa-circle-check"></i> Connected</strong>
            <% else %>
              <%= link_to "Connect Stripe", stripe_connect_onboard_path, class: "btn btn-sm btn-outline-primary" %>
            <% end %>
          </div>
        <% end %>

        <%= link_to "Edit profile", edit_user_path(@user), class: "coach-show-main-btn" %>
      </section>
    <% end %>

  </div>
</div>
